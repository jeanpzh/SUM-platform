  <diagram id="sum-architecture" name="Arquitectura SUM"><mxGraphModel page="1" pageWidth="1500" pageHeight="640" grid="1" gridSize="10" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="FISI / UNMSM — Asistente académico MVP" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry" /></mxCell><mxCell id="admin" value="Administración&#10;Organizar fuentes oficiales" style="shape=process;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="140" height="60" as="geometry" /></mxCell><mxCell id="queue" value="Cola durable&#10;Trabajos de indexación" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="140" height="60" as="geometry" /></mxCell><mxCell id="worker" value="Indexadores&#10;Analizar · dividir · vectorizar" style="shape=process;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="140" height="60" as="geometry" /></mxCell><mxCell id="kb" value="Base institucional&#10;Fuentes + metadatos&#10;Vectores publicados" style="shape=cylinder3;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="140" height="80" as="geometry" /></mxCell><mxCell id="student" value="Interfaz estudiantil&#10;Consultas + citas" style="shape=process;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="140" height="60" as="geometry" /></mxCell><mxCell id="backend" value="API backend&#10;Acceso · tareas · consultas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="280" width="140" height="60" as="geometry" /></mxCell><mxCell id="ai" value="API de IA&#10;Coordinación acotada&#10;RAG + reglas" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="140" height="80" as="geometry" /></mxCell><mxCell id="gateway" value="Pasarela de contexto académico&#10;Minimizar · normalizar&#10;Instantánea privada" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="280" width="140" height="80" as="geometry" /></mxCell><mxCell id="playwright" value="Adaptador MVP&#10;Playwright local&#10;POST autenticado" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="940" y="280" width="140" height="80" as="geometry" /></mxCell><mxCell id="future" value="Adaptador futuro&#10;API SUM autorizada&#10;Sustituye a Playwright" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="140" height="80" as="geometry" /></mxCell><mxCell id="sum" value="SUM&#10;Sistema institucional" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1300" y="280" width="140" height="60" as="geometry" /></mxCell><mxCell id="notes" value="Límites del MVP: API backend · API de IA · Pasarela SUM · Indexadores&#10;El estudiante inicia sesión en el navegador local de Playwright. No se guardan contraseñas ni sesiones.&#10;Las instantáneas quedan fuera de la base institucional. Línea continua = MVP; discontinua = futuro. La orientación no es una decisión administrativa." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1380" height="90" as="geometry" /></mxCell><mxCell id="a" value="Gestionar fuentes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="admin" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b" value="Encolar" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="backend" target="queue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c" value="Procesar" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="queue" target="worker"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d" value="Publicar" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="worker" target="kb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e" value="Consulta" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="student" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f" value="Ejecución / respuesta" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="backend" target="ai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="g" value="Recuperar evidencia" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="ai" target="kb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="h" value="Datos académicos necesarios" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="ai" target="gateway"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i" value="Contrato estable" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="gateway" target="playwright"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="j" value="JSON de la sesión" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="playwright" target="sum"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k" value="Mismo contrato" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;" edge="1" parent="1" source="gateway" target="future"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l" value="Integración futura" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;" edge="1" parent="1" source="future" target="sum"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
