FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY packages/contracts /app/packages/contracts
COPY packages/storage /app/packages/storage
COPY packages/database /app/packages/database
COPY services/backend-api /app/services/backend-api
RUN pip install --no-cache-dir ./packages/contracts ./packages/storage ./packages/database ./services/backend-api \
    && useradd --create-home --uid 10001 service
USER service
EXPOSE 8000
CMD ["uvicorn", "sum_backend.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "30"]
