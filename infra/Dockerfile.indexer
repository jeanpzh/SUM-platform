FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata HF_HOME=/tmp/huggingface \
    OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY packages/contracts /app/packages/contracts
COPY packages/storage /app/packages/storage
COPY packages/database /app/packages/database
COPY services/indexer-service /app/services/indexer-service
RUN pip install --no-cache-dir ./packages/contracts ./packages/storage ./packages/database ./services/indexer-service \
    && useradd --create-home --uid 10001 service \
    && mkdir -p /tmp/huggingface \
    && chown service:service /tmp/huggingface
USER service
EXPOSE 8001
CMD ["uvicorn", "sum_indexer.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001", "--timeout-keep-alive", "30"]
