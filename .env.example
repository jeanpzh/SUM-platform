ENV_MODE=DEVELOPMENT
# Development only. Replace these credentials before exposing the services.
API_ADMIN_TOKEN=development-admin-token-change-before-use
SERVICE_TOKEN=development-service-token-change-before-use
POSTGRES_PASSWORD=development-postgres-change-before-use
BACKEND_DB_PASSWORD=development-backend-db-change-before-use
INDEXER_DB_PASSWORD=development-indexer-db-change-before-use
RETRIEVAL_DB_PASSWORD=development-retrieval-db-change-before-use
AUTH_DB_PASSWORD=development-auth-db-change-before-use
AUTH_DATABASE_URL=postgresql://sum_auth:development-auth-db-change-before-use@127.0.0.1:5433/sum
BETTER_AUTH_SECRET=development-better-auth-secret-change-before-use
AI_IDENTITY_SECRET=development-ai-identity-secret-change-before-use
ADMIN_EMAIL_ALLOWLIST=admin@example.test
MINIO_ROOT_USER=sum-local-storage
MINIO_ROOT_PASSWORD=development-storage-root-change-before-use
BACKEND_S3_SECRET=development-backend-storage-change-before-use
INDEXER_S3_SECRET=development-indexer-storage-change-before-use
CPU_PROCESSES=2
EXTRACTION_CONCURRENCY=2
EMBEDDING_CONCURRENCY=2
WRITING_CONCURRENCY=2
MAX_PENDING_JOBS=1000
MAX_UPLOAD_BYTES=33554432
MAX_PAGES=2000
PAGE_BATCH_SIZE=10
EMBEDDING_BATCH_SIZE=32
CHUNK_TOKENS=380
CHUNK_OVERLAP=40
STAGE_TIMEOUT_SECONDS=900
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Same immutable model commit for TEI and the tokenizer/indexer.
EMBEDDING_REVISION=d13f1b27baf31030b7fd040960d60d909913633f
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_TOKENS=512
ALLOWED_ORIGINS=http://localhost:5173
# Override these images with verified digests for production.
INNGEST_IMAGE=inngest/inngest:latest
# MinIO community containers are built locally from pinned source releases.
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MINIO_CLIENT_VERSION=RELEASE.2025-08-13T08-35-41Z

# Cambia el perfil desde Administración > Configuración. Los secretos se quedan en el servidor.
# Para openai configura OPENAI_API_KEY aquí antes de cambiar el proveedor.
# OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_DRIVER=tei
AI_MODELS_JSON=[{"provider":"ollama","model":"llama3.2","input_usd_per_million":0,"output_usd_per_million":0,"pricing_date":"2026-10-03"},{"provider":"openai","model":"gpt-5.1","input_usd_per_million":1,"output_usd_per_million":8,"pricing_date":"2026-10-03"},{"provider":"anthropic","model":"claude-sonnet-4-5","input_usd_per_million":3,"output_usd_per_million":15,"pricing_date":"2026-10-03"},{"provider":"google","model":"gemini-2.5-pro","input_usd_per_million":1,"output_usd_per_million":8,"pricing_date":"2026-10-03"}]
# Provider keys are optional; models without a key appear unavailable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Persistent encryption key for Settings connections (generate once with Fernet.generate_key()).
AI_PROVIDER_ENCRYPTION_KEY=
# Hosts administrators may use for Ollama/Custom; URLs must be reachable from AI Service.
AI_PROVIDER_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,ollama
GROQ_API_KEY=
CUSTOM_AI_URL=
CUSTOM_API_KEY=

# Student consultations: server-owned model, shared Redis quotas. No SUM adapter enabled yet.
STUDENT_AI_PROVIDER=ollama
STUDENT_AI_MODEL=llama3.2
STUDENT_REQUESTS_PER_MINUTE=5
STUDENT_REQUESTS_PER_DAY=50
STUDENT_TOKENS_PER_MINUTE=20000
STUDENT_TOKENS_PER_DAY=100000
ACADEMIC_GATEWAY_URL=
# Optional JSON registry of reviewed rules, mounted read-only into AI Service.
STUDENT_RULES_FILE=
# Optional LangSmith metadata/traces; inputs and outputs are hidden in the SDK client.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=sum-student
LANGSMITH_ADMIN_PROJECT=sum-admin-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Enable only to inspect admin prompts/tool arguments in LangSmith; student traces stay masked.
LANGSMITH_ADMIN_CAPTURE_CONTENT=false
